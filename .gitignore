# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# Generated outputs from ImageSummaryApp runs
binarized.png
groups.csv

# Local experiment/build outputs
jcodec-output.csv
mvn_output.txt

# Local environment overrides (never commit secrets)
.env
.env.local

# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform/**/terraform.tfvars
!terraform/**/terraform.tfvars.example

# Real backend config — bucket/table names come from terraform/bootstrap's
# outputs and differ per account. Commit the .example, not the real one.
terraform/**/backend.tf
!terraform/**/backend.tf.example

# Sample media. ensantina.mp4 is ~33MB; git is the wrong place for it, and a
# stray `git add -A` would otherwise commit it permanently.
videos/
thumb.jpg
results/

# Local planning scratch — see docs/ for documentation that is meant to be read
refactorPlan.md
terraformPlan.md
